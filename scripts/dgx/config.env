# Stage A configuration. Sourced by every script in scripts/dgx/. Override any variable by
# exporting it before running, e.g.  ZED_ROOT=/raid/panshul/zed bash scripts/dgx/run.sh mot17
#
# Everything (env, downloads, weights, caches, logs, bring-back bundle) lives under ZED_ROOT.

: "${ZED_ROOT:=$HOME/zed-ps2-stagea}"
: "${GPU:=0}"                       # CUDA device index used for inference
: "${BATCH:=8}"                     # frames per detector batch (lower if you hit OOM)
: "${CONF_FLOOR:=0.05}"             # keep every detection with score >= this (must be <= 0.1)
: "${NMS:=0.7}"                     # ByteTrack's NMS IoU for YOLOX-X MOT models
: "${PYVER:=3.11}"
: "${FP16:=1}"                      # 0 = FP32 detector + re-ID (rules out half precision; ~2x slower)
: "${DEVICE:=cuda}"                 # testing only: cpu lets the scripts run on a laptop
: "${VARIANT:=yolox_x}"             # testing only: ByteTrack's MOT checkpoints are all YOLOX-X

ENV_DIR="$ZED_ROOT/env"
DL="$ZED_ROOT/downloads"            # zip archives (wget -c, resumable)
DATA="$ZED_ROOT/data"               # extracted datasets
WEIGHTS="$ZED_ROOT/weights"
CACHE="$ZED_ROOT/cache"             # Stage A output: <dataset>/<detector-label>/<split>/<seq>.npz
CLIPS="$ZED_ROOT/clips"             # demo MP4s
RESULTS="$ZED_ROOT/results"         # tracker outputs produced on the DGX (SOMPT22 test format)
LOGS="$ZED_ROOT/logs"
SRC="$ZED_ROOT/src"                 # pinned third-party source trees
BRING="$ZED_ROOT/bring_back"        # what to copy home (made by finalize.sh)

# ---- pinned third-party code (inference only imports their model definitions)
BYTETRACK_REPO="https://github.com/ifzhang/ByteTrack.git"
BYTETRACK_COMMIT="d1bf0191adff59bc8fcfeaa0b33d3d1642552a99"     # 2022-12-11, MIT
TORCHREID_REPO="https://github.com/KaiyangZhou/deep-person-reid.git"
TORCHREID_COMMIT="f8cd150fdf77e8d9e1ed143b7f308c2c609ded50"     # 2026-01-09, MIT

# ---- weights: name|url|bytes  (sizes checked 4 Oct 2026; Google Drive direct links, wget -c)
GD="https://drive.usercontent.google.com/download?export=download&confirm=t&id="
WEIGHT_LIST=(
  "bytetrack_ablation.pth.tar|${GD}1iqhM-6V_r1FpOlOzrdP_Ejshgk0DxOob|792835795"
  "bytetrack_x_mot17.pth.tar|${GD}1P4mY0Yyd3PPTybgZkjMYhFri88nTmJX5|792835731"
  "bytetrack_x_mot20.pth.tar|${GD}1HX2_JpMOjOIj1Z9rJjoet9XNy_cCAs5U|792835731"
  "dancetrack_bytetrack_x.pth.tar|https://huggingface.co/noahcao/dancetrack_models/resolve/main/bytetrack_models/bytetrack_model.pth.tar|792835731"
  "sparsetrack_mot20_ablation.pth.tar|${GD}1F2XwyYKj1kefLPUFRHxgnpaAmEwyoocw|792835731"
  "osnet_ain_x1_0_msmt17.pth|${GD}1SigwBE6mPdqiJMqhuIY4aqC7--5CsMal|17293009"
)
# sha256 verified on the CPU box (others are recorded at download time into weights/SHA256SUMS)
OSNET_SHA256="8a07e8da38946f7cee37f4561617bf8b6d2fe8f3a4027852893ea092e46d919f"

# ---- detector choice. x (default) = the per-dataset YOLOX-X checkpoints above. s = ByteTrack's
#      bytetrack_s_mot17 (YOLOX-S) for EVERY dataset: the laptop fallback after a CUDA
#      out-of-memory error, or `run.sh all --detector s`. It was trained on CrowdHuman + MOT17
#      (full) + CityPersons + ETHZ, so its MOT17 cache is labelled SAW_EVAL_HALF, and its rows are
#      tagged "laptop detector, not comparable to published numbers". Downloaded on first use.
: "${DETECTOR:=x}"
SMALL_WEIGHT="bytetrack_s_mot17.pth.tar|${GD}1uSmhXzyV1Zvb4TJJCzpsZOIcw7CCJLxj|71833925"
SMALL_SHA256="d224bf37c20a9966b44052d2452e6cd5327c7dab9fe9977a649bbad1b76ba220"  # CPU box, 7 Oct 2026
SMALL_TRAINED_ON="CrowdHuman + MOT17 train (full) + CityPersons + ETHZ (ByteTrack yolox_s, laptop detector)"
# cache folder labels of the small detector (SAW_EVAL_HALF: it saw MOT17 val-half; no MOT20 or
# DanceTrack data, so those are cross-domain and clean)
SMALL_LABEL_MOT17="laptop_yolox_s_SAW_EVAL_HALF"
SMALL_LABEL_XDOMAIN="laptop_yolox_s_xdomain"
# which MOT20 YOLOX-X variants `run.sh mot20` caches. The SAW_EVAL_HALF detector (trained on all of
# MOT20 train, so it saw the val half) is opt-in only since Oct 2026; add mot20full_SAW_EVAL_HALF
# here to cache it, and pass --include-leaked to eval.phase3 to score it (never a headline row).
: "${MOT20_VARIANTS:=sparsetrack_ablation mot17full_xdomain}"

# ---- datasets (no registration; MOTChallenge archives are plain downloads)
MOT17_URL="https://motchallenge.net/data/MOT17.zip"            # 5,860,214,001 bytes
MOT20_URL="https://motchallenge.net/data/MOT20.zip"            # 5,028,926,248 bytes
DANCETRACK_VAL_URL="https://huggingface.co/datasets/noahcao/dancetrack/resolve/main/val.zip"  # 4,209,785,614 bytes
SOMPT22_FOLDER="https://drive.google.com/drive/folders/1Z_gnFmX-EKUe4yLBQPa2pxXkyqYbxkhX"

# ---- demo clips. MOT20-02 is crowded; MOT17-04 is a static elevated view.
CLIP_SEQS=("MOT17/train/MOT17-04-FRCNN" "MOT20/train/MOT20-02")   # fps read from seqinfo.ini
# Pexels gate clips (free licence; check angle before use): id|slug
PEXELS=(
  "32511497|busy-subway-turnstile-in-urban-station"
  "31540854|modern-milan-metro-station-turnstiles"
  "30138564|bustling-mexico-city-metro-entrance"
  "34452568|fans-arriving-at-stadium-in-rabat"
  "7251031|man-entering-a-metro-station"
)

# The exact demo-clip encoder settings agreed with the team (input pattern / fps filled in).
FFMPEG_ARGS=(-vf scale=-2:720 -c:v libx264 -crf 23 -g 10 -pix_fmt yuv420p -movflags +faststart)
